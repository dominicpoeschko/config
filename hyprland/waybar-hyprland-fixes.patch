+// patch: windows of the special:hidden workspace, for merged rendering
+auto Workspaces::hiddenWindowMap() const -> const std::vector<WindowRepr>* {
+  for (const auto& workspace : m_workspaces) {
+    // waybar stores special workspace names without the "special:" prefix
+    if (workspace->name() == "hidden" || workspace->name() == "special:hidden") {
+      return &workspace->windowMap();
+    }
+  }
+  return nullptr;
+}
